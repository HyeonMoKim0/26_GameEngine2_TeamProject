  m_text: "\uD55C\uBC88\uC774\uB77C\uB3C4 \uC57D\uAD00\uC744 99\uC870\uAE4C\uC9C0
    \uD074\uB9AC\uC5B4\uD588\uB2E4\uBA74 \uAC8C\uC784 \uB0B4\uC5D0\uC11C \uBBF8\uB2C8\uAC8C\uC784
