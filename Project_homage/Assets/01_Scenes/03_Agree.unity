  m_text: "\uD55C\uBC88\uC774\uB77C\uB3C4 \uC57D\uAD00\uC744 99\uC870\uAE4C\uC9C0
    \uD074\uB9AC\uC5B4\uD588\uB2E4\uBA74 \uAC8C\uC784 \uB0B4\uC5D0\uC11C \uBBF8\uB2C8\uAC8C\uC784
    \uB9AC\uC2A4\uD2B8\uB97C \uBCFC \uC218 \uC788\uB2E4.\r\n\n(1) \uC911\uAC04\uC5D0
    \uB3D9\uC758\uAC00 \uBD88\uAC00\uB2A5\uD574\uC9C8 \uC218 \uC788\uB294 \uBBF8\uB2C8\uAC8C\uC784\uC740
